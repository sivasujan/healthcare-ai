# Backend environment configuration (copy to .env and fill in real values)
# --- General ---
DEBUG=false

# --- Security: CHANGE THIS in production ---
SECRET_KEY=change-me-in-production-9f8e7d6c5b4a3f2e1d0c
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (SQLite only) ---
# DATABASE_URL=sqlite:///./healthcare.db

# --- AI / OpenRouter (required for AI features) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=HealthCare Assistant

# Model tiers (primary -> secondary -> fallback -> free)
PRIMARY_MODEL=google/gemma-4-26b-a4b-it:free
SECONDARY_MODEL=openai/gpt-oss-20b:free
FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
FREE_MODEL=google/gemma-4-26b-a4b-it:free

AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# --- Admin seed account ---
ADMIN_EMAIL=admin@healthcare.local
ADMIN_PASSWORD=Admin@12345
